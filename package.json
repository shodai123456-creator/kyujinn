{
  "name": "job-match-app",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "check": "node --check app/app.js && node --check server.mjs && node --check app/sw.js && node --check worker/index.mjs && node --check src/recruitment/services/crawl-source.js",
    "test": "node --test tests/*.test.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "dev:worker": "npm run build:worker && wrangler dev --local",
    "deploy:worker": "npm run build:worker && wrangler deploy",
    "d1:migrate": "wrangler d1 migrations apply job-match --remote"
  },
  "dependencies": {
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "wrangler": "^4.118.0"
  }
}
