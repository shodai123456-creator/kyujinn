{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "job-match",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/healthz"] },
  "d1_databases": [{ "binding": "DB", "database_name": "job-match", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["0 * * * *"] }
}
