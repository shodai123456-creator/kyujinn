{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "job-match",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/healthz"] },
  "d1_databases": [{ "binding": "DB", "database_name": "job-match", "database_id": "eb14c1bb-e93c-4db6-8cdc-20789db42689", "migrations_dir": "migrations" }],
  "triggers": { "crons": [] }
}
